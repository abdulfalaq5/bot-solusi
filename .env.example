# ================= WhatsApp via Kirimdev =================
# API key: app.kirimdev.com -> Developers -> API Keys (format kdv_live_...)
KIRIM_API_KEY=
# Phone Number ID: WhatsApp -> Accounts -> ⋯ -> Copy Phone Number ID
KIRIM_PHONE_ID=
# Signing secret webhook (opsional jika webhook didaftarkan lewat halaman admin -> otomatis disimpan di DB)
# Pisahkan dengan koma untuk rotasi beberapa secret
KIRIM_WEBHOOK_SECRET=
KIRIM_BASE_URL=https://api.kirimdev.com/v1

# URL publik (HTTPS) server ini, dipakai untuk webhook: {PUBLIC_URL}/webhook/kirim
PUBLIC_URL=https://bot.domainanda.com

# ================= Kanal WhatsApp =================
# Kirimdev = WhatsApp Business API resmi. Baileys = nomor pribadi via WhatsApp Web (TIDAK resmi,
# ada risiko nomor diblokir Meta). Ubah lalu jalankan: docker compose up -d
KIRIM_ENABLED=true
BAILEYS_ENABLED=false
# secret antar service internal (api <-> wa-baileys), buat dengan: openssl rand -hex 32
BAILEYS_INTERNAL_SECRET=ganti-dengan-string-acak

# ================= Admin panel =================
WEB_PORT=8080
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ganti-password-ini
# string acak panjang, mis: openssl rand -hex 32
JWT_SECRET=ganti-dengan-string-acak

# ================= Database =================
POSTGRES_USER=bot
POSTGRES_PASSWORD=ganti-password-db
POSTGRES_DB=botsolusi

# ================= API key provider AI (opsional) =================
# Bisa juga diisi langsung di halaman admin -> Provider AI (tanpa restart).
# --- gratis / punya free tier ---
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
# --- berbayar ---
SUMOPOD_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

WORKER_CONCURRENCY=5
LOG_LEVEL=info
